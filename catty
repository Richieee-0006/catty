#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
INVOKED_NAME="$(basename "$0")"

VENV_PATH="${CATTY_VENV:-${VICICAT_VENV:-$SCRIPT_DIR/.venv}}"
if [ -d "$VENV_PATH" ]; then
    # shellcheck disable=SC1091
    source "$VENV_PATH/bin/activate"
elif [ -d "$HOME/Projects/ViciCat/.venv" ]; then
    # shellcheck disable=SC1091
    source "$HOME/Projects/ViciCat/.venv/bin/activate"
elif [ -d "$HOME/Projects/CatWalker/.venv" ]; then
    # shellcheck disable=SC1091
    source "$HOME/Projects/CatWalker/.venv/bin/activate"
fi

if [ -f "$SCRIPT_DIR/.env" ]; then
    set -a
    # shellcheck disable=SC1091
    source "$SCRIPT_DIR/.env"
    set +a
fi

export PYTHONPATH="$SCRIPT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"

case "$INVOKED_NAME" in
    catwalker) export CATTY_DEFAULT_TARGET="walker" ;;
    vicicat)   export CATTY_DEFAULT_TARGET="vicinae" ;;
    spottycat) export CATTY_DEFAULT_TARGET="spot" ;;
esac

exec python3 -m catty.main "$@"
